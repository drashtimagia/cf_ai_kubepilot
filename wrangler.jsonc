{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-kubepilot",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Workers AI has no local simulator: `remote: true` proxies AI calls to
  // Cloudflare during `npm run dev` (requires `wrangler login`).
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "KubePilotAgent", "class_name": "KubePilotAgent" }]
  },
  "workflows": [
    {
      "name": "kubepilot-diagnosis",
      "binding": "DIAGNOSIS_WORKFLOW",
      "class_name": "DiagnosisWorkflow"
    }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KubePilotAgent"] }]
}
